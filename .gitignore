# .NET build output
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/.vs/

# .NET secrets and logs
# Environment-specific appsettings carry real secrets (DB passwords,
# JWT keys, SMTP credentials). They must never be committed. The base
# appsettings.json stays in git with empty placeholders only.
backend/**/appsettings.Development.json
backend/**/appsettings.Production.json
backend/**/appsettings.Staging.json
backend/**/appsettings.Local.json
backend/**/appsettings.*.json.bak
backend/**/Logs/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env.local
frontend/Baseera/node_modules/

# Python
backend/AIChatService/__pycache__/
backend/AIChatService/*.pyc
backend/AIChatService/.venv/

# OS
.DS_Store
Thumbs.db
